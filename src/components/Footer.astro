---
import { SITE_TITLE } from '../consts';
---

<footer>
	<p>{SITE_TITLE}</p>
	<span>Notes from the western roads, kept by Maeve.</span>
</footer>

<style>
	footer {
		padding: 30px 20px 36px;
		border-top: 1px solid var(--line);
		background: var(--paper-deep);
		color: var(--muted);
		text-align: center;
	}
	footer p {
		margin: 0 0 2px;
		color: var(--forest);
		font: 500 19px/1.3 var(--font-display);
	}
	footer span {
		font-size: 12px;
	}
</style>