---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav aria-label="Main navigation">
		<a class="wordmark" href="/" aria-label={`${SITE_TITLE} home`}>
			<span class="wordmark-mark" aria-hidden="true">✦</span>
			<span class="wordmark-copy">
				<strong>{SITE_TITLE}</strong>
				<small>A hobbit's journal of distant roads</small>
			</span>
		</a>
		<div class="internal-links">
			<HeaderLink href="/">The Shire</HeaderLink>
			<HeaderLink href="/blog">The Road</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
		</div>
	</nav>
</header>
<style>
	header {
		position: relative;
		z-index: 1;
		border-bottom: 1px solid rgba(222, 191, 129, 0.35);
		background: #1b3026;
	}
	nav {
		width: min(1160px, calc(100% - 48px));
		min-height: 78px;
		margin: auto;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 24px;
	}
	.wordmark {
		display: flex;
		align-items: center;
		gap: 12px;
		color: var(--paper-light);
		text-decoration: none;
	}
	.wordmark-mark {
		width: 38px;
		aspect-ratio: 1;
		display: grid;
		place-items: center;
		border: 1px solid #c7a362;
		border-radius: 50%;
		color: #e0c17d;
		font: 700 18px/1 Georgia, serif;
	}
	.wordmark-copy {
		display: grid;
		gap: 1px;
	}
	.wordmark-copy strong {
		font: 600 19px/1.1 var(--font-display);
	}
	.wordmark-copy small {
		color: #c2b89d;
		font-size: 10px;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}
	.internal-links {
		display: flex;
		align-items: center;
		gap: 30px;
	}
	.internal-links a {
		padding: 10px 0;
		border-bottom: 1px solid transparent;
		color: #eee5d1;
		font-size: 13px;
		text-decoration: none;
		transition: color 180ms ease, border-color 180ms ease;
	}
	.internal-links a:hover,
	.internal-links a.active {
		border-color: var(--brass);
		color: #f1d392;
	}
	@media (max-width: 560px) {
		nav {
			width: calc(100% - 32px);
			min-height: 72px;
			flex-wrap: wrap;
			gap: 0 14px;
			padding: 10px 0 0;
		}
		.wordmark-copy strong {
			font-size: 17px;
		}
		.wordmark-copy small {
			font-size: 9px;
		}
		.internal-links {
			width: 100%;
			justify-content: space-between;
			gap: 16px;
		}
		.internal-links a {
			padding: 10px 0 12px;
		}
	}
</style>
